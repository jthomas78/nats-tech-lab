        <mxCell id="jwt-minting-lane" parent="1" style="rounded=1;arcSize=14;absoluteArcSize=1;html=1;fillColor=none;strokeColor=#4A515B;dashed=1;dashPattern=7 6;fontColor=#8B929B;fontSize=13;fontStyle=1;fontFamily=Inter, -apple-system, &#39;Segoe UI&#39;, sans-serif;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;" value="ACCOUNT MINTING SEQUENCE (provisioner.go)" vertex="1">
          <mxGeometry height="480" width="1700" x="48" y="680" as="geometry" />
        </mxCell>
        <mxCell id="mint-step1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#006FFF;strokeColor=#4D9BFF;fontColor=#FFFFFF;fontSize=14;fontStyle=1;fontFamily=Inter, -apple-system, &#39;Segoe UI&#39;, sans-serif;" value="1. nkeys.CreateAccount()&lt;br&gt;&lt;font color=&#39;#B7BCC2&#39; style=&#39;font-size:12px&#39;&gt;account identity keypair&lt;br&gt;pub key → JWT sub field&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="220" x="80" y="740" as="geometry" />
        </mxCell>
        <mxCell id="mint-step2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#006FFF;strokeColor=#4D9BFF;fontColor=#FFFFFF;fontSize=14;fontStyle=1;fontFamily=Inter, -apple-system, &#39;Segoe UI&#39;, sans-serif;" value="2. nkeys.CreateAccount()&lt;br&gt;&lt;font color=&#39;#B7BCC2&#39; style=&#39;font-size:12px&#39;&gt;account signing keypair&lt;br&gt;pub key → claims.SigningKeys&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="220" x="340" y="740" as="geometry" />
        </mxCell>
        <mxCell id="mint-step3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#006FFF;strokeColor=#4D9BFF;fontColor=#FFFFFF;fontSize=14;fontStyle=1;fontFamily=Inter, -apple-system, &#39;Segoe UI&#39;, sans-serif;" value="3. newAccountClaims()&lt;br&gt;&lt;font color=&#39;#B7BCC2&#39; style=&#39;font-size:12px&#39;&gt;set JS limits (mem/disk/&lt;br&gt;streams/consumers)&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="220" x="600" y="740" as="geometry" />
        </mxCell>
        <mxCell id="mint-step4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9A7B1E;strokeColor=#C4A834;fontColor=#FFFFFF;fontSize=14;fontStyle=1;fontFamily=Inter, -apple-system, &#39;Segoe UI&#39;, sans-serif;" value="4. claims.Encode()&lt;br&gt;&lt;font color=&#39;#B7BCC2&#39; style=&#39;font-size:12px&#39;&gt;sign with operator signing key&lt;br&gt;→ account JWT (Ed25519)&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="220" x="860" y="740" as="geometry" />
        </mxCell>
        <mxCell id="mint-step5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#006FFF;strokeColor=#4D9BFF;fontColor=#FFFFFF;fontSize=14;fontStyle=1;fontFamily=Inter, -apple-system, &#39;Segoe UI&#39;, sans-serif;" value="5. $SYS.REQ.CLAIMS.UPDATE&lt;br&gt;&lt;font color=&#39;#B7BCC2&#39; style=&#39;font-size:12px&#39;&gt;push JWT to resolver&lt;br&gt;no restart needed&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="220" x="1120" y="740" as="geometry" />
        </mxCell>
        <mxCell id="mint-step6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#27C07F;strokeColor=#52D99B;fontColor=#14171B;fontSize=14;fontStyle=1;fontFamily=Inter, -apple-system, &#39;Segoe UI&#39;, sans-serif;" value="6. nkeys.CreateUser()&lt;br&gt;&lt;font color=&#39;#B7BCC2&#39; style=&#39;font-size:12px&#39;&gt;user identity keypair&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="220" x="80" y="880" as="geometry" />
        </mxCell>
        <mxCell id="mint-step7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#27C07F;strokeColor=#52D99B;fontColor=#14171B;fontSize=14;fontStyle=1;fontFamily=Inter, -apple-system, &#39;Segoe UI&#39;, sans-serif;" value="7. UserClaims.Encode()&lt;br&gt;&lt;font color=&#39;#B7BCC2&#39; style=&#39;font-size:12px&#39;&gt;sign with account signing key&lt;br&gt;IssuerAccount = account pub&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="220" x="340" y="880" as="geometry" />
        </mxCell>
        <mxCell id="mint-step8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#27C07F;strokeColor=#52D99B;fontColor=#14171B;fontSize=14;fontStyle=1;fontFamily=Inter, -apple-system, &#39;Segoe UI&#39;, sans-serif;" value="8. jwt.FormatUserConfig()&lt;br&gt;&lt;font color=&#39;#B7BCC2&#39; style=&#39;font-size:12px&#39;&gt;user JWT + NKey seed&lt;br&gt;→ .creds file&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="220" x="600" y="880" as="geometry" />
        </mxCell>
        <mxCell id="mint-step9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A1E23;strokeColor=#9A7B1E;dashed=1;fontColor=#DEE0E3;fontSize=14;fontStyle=1;fontFamily=Inter, -apple-system, &#39;Segoe UI&#39;, sans-serif;" value="9. Write &amp;lt;name&amp;gt;.creds&lt;br&gt;&lt;font color=&#39;#B7BCC2&#39; style=&#39;font-size:12px&#39;&gt;to shared creds volume&lt;br&gt;shipping-svc discovers tenant&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="220" x="860" y="880" as="geometry" />
        </mxCell>
        <mxCell id="mint-step10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#27C07F;strokeColor=#52D99B;fontColor=#14171B;fontSize=14;fontStyle=1;fontFamily=Inter, -apple-system, &#39;Segoe UI&#39;, sans-serif;" value="10. Persist to Postgres&lt;br&gt;&lt;font color=&#39;#B7BCC2&#39; style=&#39;font-size:12px&#39;&gt;name · pub key · signing seed&lt;br&gt;JS limits · status=active&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="220" x="1120" y="880" as="geometry" />
        </mxCell>
