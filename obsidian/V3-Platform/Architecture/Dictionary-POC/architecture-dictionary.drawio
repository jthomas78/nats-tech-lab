        <mxCell id="jwt-phase-label" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#B7BCC2;fontSize=12;fontFamily=Inter, -apple-system, &#39;Segoe UI&#39;, sans-serif;align=left;" value="ACCOUNT MINTING (gold = operator signing)     USER MINTING (green = account signing)     PERSISTENCE (gold dashed = shared volume)" vertex="1">
          <mxGeometry height="24" width="1100" x="80" y="1000" as="geometry" />
        </mxCell>
        <mxCell id="jwt-connect-note" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#B7BCC2;fontSize=12;fontFamily=Inter, -apple-system, &#39;Segoe UI&#39;, sans-serif;align=left;" value="Connection flow: nats.UserCredentials(path) reads .creds → presents User JWT + completes NKey challenge-response → server verifies User JWT signed by account signing key → verifies account JWT signed by operator signing key → grants access to that account&#39;s isolated subject space, JetStream streams, and KV buckets" vertex="1">
          <mxGeometry height="40" width="1600" x="80" y="1030" as="geometry" />
        </mxCell>
        <mxCell id="jwt-determinism-note" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#9A7B1E;fontSize=12;fontFamily=Inter, -apple-system, &#39;Segoe UI&#39;, sans-serif;align=left;" value="⚠ Ed25519 determinism: same inputs → same JWT bytes. Reactivation adds a unique tag to force JWT to differ from the revoked version, since the resolver treats byte-identical updates as no-ops (BR-AC04)." vertex="1">
          <mxGeometry height="30" width="1500" x="80" y="1070" as="geometry" />
        </mxCell>
