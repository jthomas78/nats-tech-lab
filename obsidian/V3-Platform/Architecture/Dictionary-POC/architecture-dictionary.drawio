  <diagram id="rpc-proposed" name="PROPOSED — Dual-transport RPC (draft)">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1060" background="#14171B" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="page-bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#14171B;strokeColor=none;locked=1;editable=0;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1800" height="1060" as="geometry" />
        </mxCell>
        <mxCell id="title" value="Dual-transport RPC — REST + NATS request/reply" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#DEE0E3;fontSize=28;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Inter, -apple-system, &#39;Segoe UI&#39;, sans-serif;" vertex="1" parent="1">
          <mxGeometry x="56" y="28" width="1100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="One application layer (commands/queries), two adapters — rpc.* covers only the cross-service calls a caller needs synchronously, not the full REST surface" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#B7BCC2;fontSize=15;align=left;verticalAlign=middle;fontFamily=Inter, -apple-system, &#39;Segoe UI&#39;, sans-serif;" vertex="1" parent="1">
          <mxGeometry x="56" y="67" width="1300" height="28" as="geometry" />
        </mxCell>
        <mxCell id="draft-badge" value="DRAFT — FOR DISCUSSION, NOT YET PLANNED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9A7B1E;dashed=1;fontColor=#9A7B1E;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Inter, -apple-system, &#39;Segoe UI&#39;, sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1466" y="30" width="290" height="36" as="geometry" />
        </mxCell>
        <mxCell id="refdata-boundary" value="REFDATA-SERVICE" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4A515B;dashed=1;dashPattern=7 6;fontColor=#8B929B;fontSize=15;fontStyle=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=22;fontFamily=Inter, -apple-system, &#39;Segoe UI&#39;, sans-serif;" vertex="1" parent="1">
          <mxGeometry x="48" y="140" width="980" height="760" as="geometry" />
        </mxCell>
        <mxCell id="shipping-boundary" value="SHIPPING-SERVICE" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4A515B;dashed=1;dashPattern=7 6;fontColor=#8B929B;fontSize=15;fontStyle=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=22;fontFamily=Inter, -apple-system, &#39;Segoe UI&#39;, sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1120" y="140" width="632" height="760" as="geometry" />
        </mxCell>
        <mxCell id="rest-adapter" value="rest/ adapter&lt;br&gt;&lt;font color=&#39;#B7BCC2&#39; style=&#39;font-size:12px&#39;&gt;HTTP + Swagger (existing)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#006FFF;strokeColor=#4D9BFF;fontColor=#FFFFFF;fontSize=16;fontStyle=1;fontFamily=Inter, -apple-system, &#39;Segoe UI&#39;, sans-serif;verticalAlign=bottom;spacingBottom=10;" vertex="1" parent="1">
          <mxGeometry x="110" y="210" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="natsrpc-adapter" value="natsrpc/ adapter (NEW)&lt;br&gt;&lt;font color=&#39;#B7BCC2&#39; style=&#39;font-size:12px&#39;&gt;NATS request/reply&lt;br&gt;rpc.{context}.refdata.{entity}.{action}.v1&lt;br&gt;via NATS Micro/Services — $SRV.PING/INFO/STATS discovery&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A1E23;strokeColor=#9A7B1E;dashed=1;fontColor=#DEE0E3;fontSize=16;fontStyle=1;fontFamily=Inter, -apple-system, &#39;Segoe UI&#39;, sans-serif;verticalAlign=bottom;spacingBottom=10;" vertex="1" parent="1">
          <mxGeometry x="460" y="210" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="commands-node" value="commands / queries&lt;br&gt;&lt;font color=&#39;#14171B&#39; style=&#39;font-size:12px&#39;&gt;application layer — unchanged, same structs both adapters call&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#27C07F;strokeColor=#52D99B;fontColor=#14171B;fontSize=17;fontStyle=1;fontFamily=Inter, -apple-system, &#39;Segoe UI&#39;, sans-serif;verticalAlign=bottom;spacingBottom=10;" vertex="1" parent="1">
