        </mxCell>
        <mxCell id="domain-node" value="domain&lt;br&gt;&lt;font color=&#39;#B7BCC2&#39; style=&#39;font-size:12px&#39;&gt;business rules&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#006FFF;strokeColor=#4D9BFF;fontColor=#FFFFFF;fontSize=16;fontStyle=1;fontFamily=Inter, -apple-system, &#39;Segoe UI&#39;, sans-serif;verticalAlign=bottom;spacingBottom=10;" vertex="1" parent="1">
          <mxGeometry x="230" y="600" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="store-node" value="Postgres + KV&lt;br&gt;&lt;font color=&#39;#14171B&#39; style=&#39;font-size:12px&#39;&gt;source of truth&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#27C07F;strokeColor=#52D99B;fontColor=#14171B;fontSize=16;fontStyle=1;fontFamily=Inter, -apple-system, &#39;Segoe UI&#39;, sans-serif;verticalAlign=bottom;spacingBottom=10;" vertex="1" parent="1">
