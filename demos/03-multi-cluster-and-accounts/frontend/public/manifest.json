{
  "id": "demo-03",
  "name": "Multi-cluster - T4 playground",
  "version": "0.1.0",
  "description": "Freeze a region of the live nine-server T4 rig, resume it, or request the meta leader in another cluster. Then watch what the servers report.",
  "schemaVersion": 1,
  "shellApiVersion": 1,
  "routePrefix": "demo-03",
  "remote": {
    "kind": "federated",
    "url": "/plugins/demo-03/remoteEntry.js",
    "name": "demo_03",
    "module": "plugin"
  },
  "contributions": [
    {
      "kind": "route",
      "id": "meta-leader",
      "path": "/demo-03/meta-leader/:tab(overview|live)?",
      "title": "Clusters — Meta-Leader",
      "component": "meta-leader"
    },
    {
      "kind": "route",
      "id": "playground",
      "path": "/demo-03/playground",
      "title": "Clusters — Meta-Leader",
      "component": "legacy",
      "default": true
    },
    {
      "kind": "route",
      "id": "overview",
      "path": "/demo-03/overview",
      "title": "Clusters — Meta-Leader",
      "component": "legacy"
    },
    {
      "kind": "navigation",
      "id": "meta-leader-nav",
      "label": "Meta-Leader",
      "route": "meta-leader",
      "icon": "pi pi-sitemap",
      "order": 30,
      "group": { "id": "clusters", "label": "Clusters" }
    }
  ],
  "backendServices": []
}
