# Cell au-1 -- Australia, AWS ap-southeast-2 in production.
# Same files as za-1. Only these numbers differ.
#
# Offsets: +50 for anything inside the two fixed bands CLAUDE.md pins
# (7100-7199 frontends, 7200-7299 backends), so za-1 takes the low half and
# au-1 the high half and neither leaves its band. +100 for the conventional
# ports (NATS, Postgres, Temporal UI), which sit in no band.
CELL=au-1
REGION=au

# NATS and Postgres keep their conventional ports (CLAUDE.md).
NATS_CLIENT_PORT=4322
NATS_MONITOR_PORT=8322
NATS_WS_PORT=9322
PG_PORT=5532

# Backend / API services -- 7250-7299 half of the 7200-7299 band.
SHIPPING_PORT=7250
REFDATA_PORT=7251
ACCOUNTS_PORT=7252
PRICING_PORT=7253
ORGANIZATIONS_PORT=7254
OBSERVABILITY_PORT=7255
MFE_REGISTRY_PORT=7256
TEMPORAL_GRPC_PORT=7283

# Frontend dev/serve ports -- 7150-7199 half of the 7100-7199 band.
ADMIN_UI_PORT=7150
SHIPPING_UI_PORT=7151
REFDATA_UI_PORT=7152
DOCS_UI_PORT=7156
APP_SHELL_PORT=7160
PLUGIN_EXAMPLE_PORT=7161
PLUGIN_CATALOG_PORT=7162
PLUGIN_SLOW_PORT=7163
PLUGIN_THROWS_PORT=7164
PLUGIN_INCOMPATIBLE_PORT=7165

# Lab tooling, conventional ports.
TEMPORAL_UI_PORT=8333

# Phase 54 OTel stack (compose.telemetry.yaml). +50, not +100: the offset
# Phase 54 decision 2 fixed for Grafana.
GRAFANA_PORT=3050

# Tempo hides the newest part of every search (query_end_cutoff, default
# 30s), so a new trace is searchable ~30 s after it starts. Local cells use
# 5s to see traces sooner (10-15 s, measured with otel-stackcheck movedelay).
# A live env file leaves this out and keeps 30s. Never 0: the live-store
# runs with fail_on_high_lag, which needs the cutoff.
TEMPO_QUERY_END_CUTOFF=5s
