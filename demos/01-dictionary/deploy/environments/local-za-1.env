# Cell za-1 -- South Africa, AWS af-south-1 in production.
# This cell holds every base port, so it matches the old flat
# demos/01-dictionary/docker-compose.yml exactly. Nothing you already know
# about port numbers changes when you run this cell.
CELL=za-1
REGION=za

# NATS and Postgres keep their conventional ports (CLAUDE.md).
NATS_CLIENT_PORT=4222
NATS_MONITOR_PORT=8222
NATS_WS_PORT=9222
PG_PORT=5432

# Backend / API services -- 7200-7249 half of the 7200-7299 band.
SHIPPING_PORT=7200
REFDATA_PORT=7201
ACCOUNTS_PORT=7202
PRICING_PORT=7203
ORGANIZATIONS_PORT=7204
OBSERVABILITY_PORT=7205
MFE_REGISTRY_PORT=7206
TEMPORAL_GRPC_PORT=7233

# Frontend dev/serve ports -- 7100-7149 half of the 7100-7199 band.
ADMIN_UI_PORT=7100
SHIPPING_UI_PORT=7101
REFDATA_UI_PORT=7102
DOCS_UI_PORT=7106
APP_SHELL_PORT=7110
PLUGIN_EXAMPLE_PORT=7111
PLUGIN_CATALOG_PORT=7112
PLUGIN_SLOW_PORT=7113
PLUGIN_THROWS_PORT=7114
PLUGIN_INCOMPATIBLE_PORT=7115

# Lab tooling, conventional ports.
TEMPORAL_UI_PORT=8233

# Phase 54 OTel stack (compose.telemetry.yaml). Grafana is the only OTel
# service published on the host.
GRAFANA_PORT=3000

# Tempo hides the newest part of every search (query_end_cutoff, default
# 30s), so a new trace is searchable ~30 s after it starts. Local cells use
# 5s to see traces sooner (10-15 s, measured with otel-stackcheck movedelay).
# A live env file leaves this out and keeps 30s. Never 0: the live-store
# runs with fail_on_high_lag, which needs the cutoff.
TEMPO_QUERY_END_CUTOFF=5s
