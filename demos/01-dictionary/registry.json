{
  "schemaVersion": 1,
  "plugins": [
    {
      "id": "example-plugin",
      "enabled": true,
      "name": "Example Plugin",
      "version": "0.1.1",
      "description": "The BR-AS15 proof plugin: one contribution of every kind, built and served independently on port 7111.",
      "schemaVersion": 1,
      "shellApiVersion": 1,
      "routePrefix": "example",
      "remote": {
        "kind": "federated",
        "url": "http://localhost:7111/remoteEntry.js",
        "name": "example_plugin",
        "module": "plugin"
      },
      "contributions": [
        {
          "kind": "route",
          "id": "overview",
          "path": "/example",
          "title": "Example Plugin",
          "component": "overview"
        },
        {
          "kind": "navigation",
          "id": "overview-nav",
          "label": "Example Plugin",
          "route": "overview",
          "icon": "pi pi-bolt",
          "order": 10
        },
        {
          "kind": "extension",
          "id": "home-panel",
          "target": "shell/home-main/v1",
          "component": "home-panel",
          "order": 10
        },
        {
          "kind": "extension",
          "id": "home-panel-broken",
          "target": "shell/home-main/v1",
          "component": "render-throws",
          "order": 20
        },
        {
          "kind": "extension",
          "id": "demo-sidebar",
          "target": "demo-catalog/details-sidebar/v1",
          "component": "demo-sidebar",
          "order": 10
        },
        {
          "kind": "shell-control",
          "id": "stream-toggle",
          "region": "shell/topbar-controls/v1",
          "component": "topbar-control",
          "routes": [
            "/example"
          ],
          "order": 10
        },
        {
          "kind": "shell-footer",
          "id": "version",
          "component": "footer-item",
          "order": 10
        }
      ]
    },
    {
      "id": "example-plugin-slow",
      "enabled": true,
      "name": "Example Plugin (slow remote)",
      "version": "0.1.1",
      "description": "Task 1b-4 (a): the same code behind a six-second module-scope delay, so the pending-region animation can be watched.",
      "schemaVersion": 1,
      "shellApiVersion": 1,
      "routePrefix": "example-slow",
      "remote": {
        "kind": "federated",
        "url": "http://localhost:7113/remoteEntry.js",
        "name": "example_plugin_slow",
        "module": "plugin"
      },
      "contributions": [
        {
          "kind": "route",
          "id": "overview",
          "path": "/example-slow",
          "title": "Slow remote",
          "component": "overview"
        },
        {
          "kind": "navigation",
          "id": "overview-nav",
          "label": "Slow remote",
          "route": "overview",
          "icon": "pi pi-hourglass",
          "order": 20
        }
      ]
    },
    {
      "id": "example-plugin-unreachable",
      "enabled": true,
      "name": "Example Plugin (unreachable remote)",
      "version": "0.1.1",
      "description": "Task 1b-4 (b): a curated remote whose chunk 404s. The plugin goes failed; nothing else moves.",
      "schemaVersion": 1,
      "shellApiVersion": 1,
      "routePrefix": "example-gone",
      "remote": {
        "kind": "federated",
        "url": "http://localhost:7111/no-such-remoteEntry.js",
        "name": "example_plugin_missing",
        "module": "plugin"
      },
      "contributions": [
        {
          "kind": "route",
          "id": "overview",
          "path": "/example-gone",
          "title": "Unreachable remote",
          "component": "overview"
        },
        {
          "kind": "navigation",
          "id": "overview-nav",
          "label": "Unreachable remote",
          "route": "overview",
          "icon": "pi pi-times-circle",
          "order": 30
        }
      ]
    },
    {
      "id": "example-plugin-activate-throws",
      "enabled": true,
      "name": "Example Plugin (activate throws)",
      "version": "0.1.1",
      "description": "Task 1b-4 (c): the chunk arrives and activate() throws. Distinguished from an unreachable remote by its cause code, not by a shrug.",
      "schemaVersion": 1,
      "shellApiVersion": 1,
      "routePrefix": "example-throws",
      "remote": {
        "kind": "federated",
        "url": "http://localhost:7114/remoteEntry.js",
        "name": "example_plugin_activate_throws",
        "module": "plugin"
      },
      "contributions": [
        {
          "kind": "route",
          "id": "overview",
          "path": "/example-throws",
          "title": "Activate throws",
          "component": "overview"
        },
        {
          "kind": "navigation",
          "id": "overview-nav",
          "label": "Activate throws",
          "route": "overview",
          "icon": "pi pi-exclamation-triangle",
          "order": 40
        }
      ]
    },
    {
      "id": "example-plugin-incompatible",
      "enabled": true,
      "name": "Example Plugin (future shell API)",
      "version": "0.1.1",
      "description": "Task 1b-4 (d): built against shellApiVersion 2. Rejected on metadata alone \u2014 its remote is never fetched (BR-AS13).",
      "schemaVersion": 1,
      "shellApiVersion": 2,
      "routePrefix": "example-next",
      "remote": {
        "kind": "federated",
        "url": "http://localhost:7115/remoteEntry.js",
        "name": "example_plugin_incompatible",
        "module": "plugin"
      },
      "contributions": [
        {
          "kind": "route",
          "id": "overview",
          "path": "/example-next",
          "title": "Future shell API",
          "component": "overview"
        }
      ]
    },
    {
      "id": "demo-catalog",
      "name": "Demo Catalog",
      "version": "1.0.0",
      "description": "The lab menu: every demo, its intro, and how to launch it.",
      "schemaVersion": 1,
      "shellApiVersion": 1,
      "routePrefix": "demos",
      "remote": {
        "kind": "federated",
        "name": "demo_catalog",
        "url": "http://localhost:7112/remoteEntry.js",
        "module": "plugin"
      },
      "extensionPoints": [
        {
          "id": "demo-catalog/details-sidebar/v1",
          "capacity": 4,
          "description": "Sidebar panels beside a demo intro."
        }
      ],
      "contributions": [
        {
          "kind": "route",
          "id": "catalog",
          "path": "/demos",
          "title": "Demos",
          "component": "catalog"
        },
        {
          "kind": "route",
          "id": "intro",
          "path": "/demos/:id",
          "title": "Demo intro",
          "component": "intro"
        },
        {
          "kind": "navigation",
          "id": "demos",
          "label": "Demos",
          "route": "catalog",
          "icon": "pi pi-th-large",
          "order": -100
        }
      ],
      "enabled": true
    }
  ]
}
