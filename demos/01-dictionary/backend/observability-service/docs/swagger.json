                "outBytes": {
                    "type": "integer"
                },
                "outMsgs": {
                    "type": "integer"
                },
                "slowConsumers": {
                    "description": "SlowConsumers is the one field on this endpoint an operator has to act\non — the Admin UI renders this one as an alarm, not a stat.",
                    "type": "integer"
                },
                "subscriptions": {
                    "type": "integer"
                },
                "tenantLabel": {
