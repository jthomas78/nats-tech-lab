{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "refdata",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "demos/01-dictionary/frontend/refdata",
      "port": 7102
    },
    {
      "name": "refdata-vs-docker",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--config",
        "vite.docker.config.js"
      ],
      "cwd": "demos/01-dictionary/frontend/refdata",
      "port": 7103
    },
    {
      "//": "Added Phase 38d-i. Same purpose as refdata-vs-docker (dev server against the dockerized stack) but on 7107, because docker-compose already publishes every port from 7100 to 7106 (nats-ui took 7103, the port refdata-vs-docker's own vite.docker.config.js pins with strictPort) and holds them whenever the stack is up. The base vite.config already proxies /api/auth to accounts-service (7202) and /api to refdata-service (7201), both host ports of the running stack, so no config override is needed here.",
      "name": "refdata-dev-docker-7107",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "7107", "--strictPort"],
      "cwd": "demos/01-dictionary/frontend/refdata",
      "port": 7107
    },
    {
      "name": "seafreight-app",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "demos/01-dictionary/frontend/seafreight-app",
      "port": 7101
    },
    {
      "name": "admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "demos/01-dictionary/frontend/admin",
      "port": 7100,
      "autoPort": true
    },
    {
      "name": "lab-shell",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "lab-shell",
      "port": 5176,
      "autoPort": true
    },
    {
      "name": "docs",
