{
  "_comment": [
    "The curated plugin registry for local review (BR-AS01, BR-AS15).",
    "Since Phase 2a this is the SEED INPUT, not configuration the service",
    "reads at boot: load it with `go run ./cmd/seed-registry -file <this>`",
    "against a running accounts-service, then run `npm run dev` here; the",
    "shell on :7109 will discover all five entries below. Curation is the",
    "operator's and lives outside both codebases — which is what makes adding",
    "a plugin cost neither a shell rebuild nor a service rebuild (BR-AS03).",
    "",
    "Four of the five entries are deliberately broken, one per failure mode the",
    "phase has to demonstrate live (task 1b-4). They are curated entries rather",
    "than query parameters on purpose: a browser must never be able to nominate",
    "a remote or alter one (BR-AS01)."
  ],
  "schemaVersion": 1,
  "revision": "dev-1b",
  "plugins": [
    {
      "id": "example-plugin",
      "enabled": true,
      "name": "Example Plugin",
      "version": "0.1.1",
      "description": "The BR-AS15 proof plugin: one contribution of every kind, built and served independently on port 7110.",
      "schemaVersion": 1,
      "shellApiVersion": 1,
      "routePrefix": "example",
      "remote": {
        "kind": "federated",
        "url": "http://localhost:7110/remoteEntry.js",
        "name": "example_plugin",
        "module": "plugin"
      },
      "contributions": [
        {
          "kind": "route",
          "id": "overview",
          "path": "/example",
          "title": "Example Plugin",
          "component": "overview"
        },
        {
          "kind": "navigation",
          "id": "overview-nav",
          "label": "Example Plugin",
          "route": "overview",
          "icon": "pi pi-bolt",
          "order": 10
        },
        {
          "kind": "extension",
          "id": "home-panel",
          "target": "shell/home-main/v1",
          "component": "home-panel",
          "order": 10
        },
        {
          "kind": "extension",
          "id": "home-panel-broken",
          "target": "shell/home-main/v1",
          "component": "render-throws",
          "order": 20
        },
        {
          "kind": "extension",
          "id": "demo-sidebar",
          "target": "demo-catalog/details-sidebar/v1",
          "component": "demo-sidebar",
          "order": 10
        },
        {
          "kind": "shell-control",
          "id": "stream-toggle",
          "region": "shell/topbar-controls/v1",
          "component": "topbar-control",
          "routes": ["/example"],
          "order": 10
        },
        {
          "kind": "shell-footer",
          "id": "version",
          "component": "footer-item",
          "order": 10
        }
      ]
    },
    {
      "id": "example-plugin-slow",
      "enabled": true,
      "name": "Example Plugin (slow remote)",
      "version": "0.1.1",
      "description": "Task 1b-4 (a): the same code behind a six-second module-scope delay, so the pending-region animation can be watched.",
      "schemaVersion": 1,
      "shellApiVersion": 1,
      "routePrefix": "example-slow",
      "remote": {
        "kind": "federated",
        "url": "http://localhost:7110/remoteEntry.js",
        "name": "example_plugin",
        "module": "plugin-slow"
      },
      "contributions": [
        {
          "kind": "route",
          "id": "overview",
          "path": "/example-slow",
          "title": "Slow remote",
          "component": "overview"
        },
        {
          "kind": "navigation",
          "id": "overview-nav",
          "label": "Slow remote",
          "route": "overview",
          "icon": "pi pi-hourglass",
          "order": 20
        }
      ]
    },
    {
      "id": "example-plugin-unreachable",
      "enabled": true,
      "name": "Example Plugin (unreachable remote)",
      "version": "0.1.1",
      "description": "Task 1b-4 (b): a curated remote whose chunk 404s. The plugin goes failed; nothing else moves.",
      "schemaVersion": 1,
      "shellApiVersion": 1,
      "routePrefix": "example-gone",
      "remote": {
        "kind": "federated",
        "url": "http://localhost:7110/no-such-remoteEntry.js",
        "name": "example_plugin_missing",
        "module": "plugin"
      },
      "contributions": [
        {
          "kind": "route",
          "id": "overview",
          "path": "/example-gone",
          "title": "Unreachable remote",
          "component": "overview"
        },
        {
          "kind": "navigation",
          "id": "overview-nav",
          "label": "Unreachable remote",
          "route": "overview",
          "icon": "pi pi-times-circle",
          "order": 30
        }
      ]
    },
    {
      "id": "example-plugin-activate-throws",
      "enabled": true,
      "name": "Example Plugin (activate throws)",
      "version": "0.1.1",
      "description": "Task 1b-4 (c): the chunk arrives and activate() throws. Distinguished from an unreachable remote by its cause code, not by a shrug.",
      "schemaVersion": 1,
      "shellApiVersion": 1,
      "routePrefix": "example-throws",
      "remote": {
        "kind": "federated",
        "url": "http://localhost:7110/remoteEntry.js",
        "name": "example_plugin",
        "module": "plugin-activate-throws"
      },
      "contributions": [
        {
          "kind": "route",
          "id": "overview",
          "path": "/example-throws",
          "title": "Activate throws",
          "component": "overview"
        },
        {
          "kind": "navigation",
          "id": "overview-nav",
          "label": "Activate throws",
          "route": "overview",
          "icon": "pi pi-exclamation-triangle",
          "order": 40
        }
      ]
    },
    {
      "id": "example-plugin-incompatible",
      "enabled": true,
      "name": "Example Plugin (future shell API)",
      "version": "0.1.1",
      "description": "Task 1b-4 (d): built against shellApiVersion 2. Rejected on metadata alone — its remote is never fetched (BR-AS13).",
      "schemaVersion": 1,
      "shellApiVersion": 2,
      "routePrefix": "example-next",
      "remote": {
        "kind": "federated",
        "url": "http://localhost:7110/remoteEntry.js",
        "name": "example_plugin",
        "module": "plugin"
      },
      "contributions": [
        {
          "kind": "route",
          "id": "overview",
          "path": "/example-next",
          "title": "Future shell API",
          "component": "overview"
        }
      ]
    }
  ]
}
